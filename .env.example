# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Mode of Operation
# - german_only
# - english_only
# - bilingual_single_channel
# - two_channels
BOT_MODE=german_only

# Default or legacy channel ID
TELEGRAM_CHANNEL_ID=@your_general_channel

# Language-specific channel IDs
TELEGRAM_CHANNEL_ID_DE=@your_german_channel
TELEGRAM_CHANNEL_ID_EN=@your_english_channel

# LLM Provider Configuration
# Primary path: GROQ_API_KEY -> GROQ_FALLBACK_KEY
GROQ_API_KEY=your_primary_groq_key_here
GROQ_FALLBACK_KEY=your_secondary_groq_key_here
